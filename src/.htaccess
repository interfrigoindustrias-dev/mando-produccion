# Control de Puertas — configuración de Apache (Hostinger)

# --- Tipos MIME correctos -------------------------------------------------
# Sin esto el manifiesto se sirve como text/plain y algunos navegadores lo
# rechazan, dejando la aplicación como no instalable.
AddType application/manifest+json .webmanifest
AddType text/javascript           .js
AddType image/png                 .png
AddType image/x-icon              .ico

# --- Caché ----------------------------------------------------------------
<IfModule mod_headers.c>
  # El service worker NUNCA se cachea: si el servidor lo retiene, los equipos
  # ya instalados no verían las versiones nuevas.
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # El HTML se revalida siempre; el service worker se encarga de servirlo
  # rápido desde su propia caché.
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # El codigo se revalida siempre. Son respuestas 304 vacias, practicamente
  # gratis, y garantizan que una version publicada llegue de inmediato.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Las imagenes si pueden retenerse: cambian muy de vez en cuando.
  <FilesMatch "\.(png|ico|webp|jpg|svg)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # El sello de version se pide siempre fresco: es lo que permite detectar que
  # un equipo esta ejecutando codigo viejo.
  <FilesMatch "version\.json$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compresión -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript \
                                application/javascript application/manifest+json \
                                image/svg+xml
</IfModule>

# --- Seguridad ------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sin listados de directorio
Options -Indexes

# --- Proteccion de credenciales y sesiones ---------------------------------
# auth.config.php solo devuelve un array, asi que nunca imprime nada aunque se
# pida por HTTP. Aun asi se bloquea: defensa en profundidad.
<Files "auth.config.php">
  Require all denied
</Files>

# El directorio de sesiones guarda los permisos de renovacion de cada usuario.
<FilesMatch "^sess_">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.sesiones(/.*)?$

# Las respuestas de auth.php no se guardan jamas.
<Files "auth.php">
  Header set Cache-Control "no-store, no-cache, must-revalidate"
</Files>
